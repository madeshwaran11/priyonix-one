# PriyoniX One - frontend environment template.
#
# Copy to frontend/.env and adjust the value, or export the variable before
# running the dev server or the build. Vite embeds VITE_* values at build
# time and inlines them in the bundle.
#
# Never put a secret in this file: everything in it ends up in the browser.

# Base URL of the backend API. Defaults to http://localhost:8080.
VITE_API_BASE=http://localhost:8080
