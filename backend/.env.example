# PriyoniX One - backend environment template.
#
# Copy to backend/.env and fill in the values locally, or provide the same
# names through your secret manager. Spring Boot does NOT read this file
# automatically: export the variables in your shell, IDE run configuration,
# container or platform settings.
#
# Never commit real secrets.

# ----- Required ---------------------------------------------------------
MONGODB_URI=
# Use a replica-set URI, e.g. mongodb://127.0.0.1:27017/?replicaSet=priyonix-local
MONGODB_DATABASE=priyonix
JWT_SECRET=

# ----- Admin seeding (optional) ------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
ADMIN_RESET_TOKEN=

# ----- HTTP / CORS -------------------------------------------------------
# Comma separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----- Role model --------------------------------------------------------
# Persists the canonical ADMIN / EMPLOYEE roles for legacy accounts.
ROLE_MIGRATION_ENABLED=true

# ----- Rate limiting -----------------------------------------------------
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_MAX_IP_ATTEMPTS=30
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_FORGOT_MAX_REQUESTS=5
AUTH_FORGOT_MAX_IP_REQUESTS=20
AUTH_FORGOT_WINDOW_MINUTES=60
AUTH_RESET_MAX_ATTEMPTS=10
AUTH_RESET_WINDOW_MINUTES=15
# Only enable behind a trusted reverse proxy.
AUTH_TRUST_FORWARDED_FOR=false

# ----- Password reset ----------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Development only: prints reset links to the console. Keep it false in
# production - it prints a live credential.
PASSWORD_RESET_DEV_MODE=false

# ----- Remember me (refresh cookie) --------------------------------------
# Lifetime of the HttpOnly refresh cookie in days.
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=px_refresh
# Set to true in production so the cookie is only sent over HTTPS.
AUTH_REFRESH_COOKIE_SECURE=false
# Lax works when the API and the frontend share a site; use None (and
# Secure=true) when they are deployed on different domains.
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
# Optional domain attribute of the refresh cookie.
AUTH_REFRESH_COOKIE_DOMAIN=

# ----- Mail delivery (password reset) ------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_RESET_LINK_BASE=http://localhost:5173
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
